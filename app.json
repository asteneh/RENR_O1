{
  "expo": {
    "name": "Gadal Market",
    "slug": "New_Rent",
    "version": "8.0.0",
    "versionCode": 8,
    "orientation": "portrait",
    "icon": "./assets/orange-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "gadalmarket",
    "splash": {
      "image": "./assets/orange-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
  "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.gadalmarket.app",
  "buildNumber": "1",
  "infoPlist": {
    "ITSAppUsesNonExemptEncryption": false
  },
  "associatedDomains": [
    "applinks:gadalmarket.com"
  ]
},
    "android": {
      "icon": "./assets/android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gadalmarket",
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "gadalmarket.com",
              "pathPrefix": "/referral"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "45cd56e3-5181-4b54-8b92-fcf4d07edf89"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/orange-logo.png",
          "color": "#FF8C00"
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
